      (List.range c.size).map (label S color c)) :=
    Primrec.list_map (Primrec.list_range.comp size_primrec) (label_primrec S color)
  exact Primrec.of_equiv_symm.comp
    (Primrec.pair size_primrec (Primrec.pair hlabels
      (Primrec.pair ((relationList_primrec S).comp Primrec.id (Primrec.const 0))
        (Primrec.pair ((relationList_primrec S).comp Primrec.id (Primrec.const 1))
