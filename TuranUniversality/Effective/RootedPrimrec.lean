theorem declaredCodes_primrec : Primrec₂ (declaredCodes S) := by
  have hp : PrimrecRel (fun p : RootedCode Roots × ℕ => Declared S p.1 p.2) :=
    (declared_primrec S).comp (Primrec.fst.comp Primrec.fst)
      (Primrec.pair (Primrec.snd.comp Primrec.fst) Primrec.snd)
  exact (filter_primrec hp).comp Primrec.id (Primrec.const Finset.univ.toList)

variable {Alphabet : Type*} [Inhabited Alphabet] [Primcodable Alphabet]

theorem label_primrec (color : Code → Alphabet) : Primrec₂ (label S color) :=
  Primrec.option_getD_default.comp ((Primrec.option_map₁ (Primrec.dom_finite color)).comp
    (Primrec.list_head?.comp (declaredCodes_primrec S)))

theorem relationList_primrec : Primrec₂ (relationList S) := by
  have hp : PrimrecRel (fun p : RootedCode Roots × Fin 3 => fun q : ℕ × ℕ =>
      Relation S p.1 p.2 q.1 q.2) :=
    (relation_primrec S).comp (Primrec.fst.comp Primrec.fst)
      (Primrec.pair (Primrec.snd.comp Primrec.fst) Primrec.snd)
  exact (filter_primrec hp).comp Primrec.id
    (cartesian_primrec.comp (Primrec.list_range.comp (size_primrec.comp Primrec.fst))
      (Primrec.list_range.comp (size_primrec.comp Primrec.fst)))

