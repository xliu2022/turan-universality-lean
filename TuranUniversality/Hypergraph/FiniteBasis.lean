module

public import TuranUniversality.Hypergraph.Hom

@[expose] public section

/-!
# Actual finite enumeration and forbidden bases

Every labeled finite uniform hypergraph is enumerated by a subset of the
finite set of all possible edges. A decidable monotone class with a proved
bounded obstruction property therefore has an explicit finite forbidden basis.
No isomorphism canonicalization is required.
-/

namespace TuranUniversality

universe u

namespace RGraph

variable {V : Type u} [DecidableEq V] [Fintype V] {r : ℕ}

/-- Enumeration of all simple r-uniform hypergraphs on V. -/
def enumerate (V : Type u) [DecidableEq V] [Fintype V] (r : ℕ) : Finset (RGraph V r) :=
  ((Finset.univ : Finset V).powersetCard r).powerset.attach.image fun p =>
    ⟨p.val, fun _e he => (Finset.mem_powersetCard.mp
      (Finset.mem_powerset.mp p.property he)).2⟩

@[simp] theorem mem_enumerate (G : RGraph V r) : G ∈ enumerate V r := by
  let p : ((Finset.univ : Finset V).powersetCard r).powerset :=
    ⟨G.edges, Finset.mem_powerset.mpr (fun e he =>
      Finset.mem_powersetCard.mpr ⟨Finset.subset_univ _, G.uniform e he⟩)⟩
  exact Finset.mem_image.mpr ⟨p, Finset.mem_attach _ _, RGraph.ext rfl⟩

instance : Fintype (RGraph V r) := ⟨enumerate V r, mem_enumerate⟩

end RGraph

/-- A labeled finite hypergraph, including its actual number of vertices. -/
abbrev FiniteGraph (r : ℕ) := Σ n : ℕ, RGraph (Fin n) r

namespace FiniteGraph

def Contains {r : ℕ} (A G : FiniteGraph r) : Prop :=
  ∃ f, A.2.IsEmbedding G.2 f

instance {r : ℕ} (A G : FiniteGraph r) : Decidable (A.Contains G) :=
  inferInstanceAs (Decidable (∃ f, A.2.IsEmbedding G.2 f))

def ClassMonotone {r : ℕ} (C : FiniteGraph r → Prop) : Prop :=
  ∀ A G, A.Contains G → C G → C A

/-- All labeled hypergraphs of order at most B, generated by finite enumeration. -/
def bounded (r B : ℕ) : Finset (FiniteGraph r) :=
  (Finset.univ : Finset (Σ n : Fin (B + 1), RGraph (Fin n.val) r)).image
    (fun p => ⟨p.1.val, p.2⟩)

@[simp] theorem mem_bounded {r B : ℕ} (G : FiniteGraph r) :
    G ∈ bounded r B ↔ G.1 ≤ B := by
  constructor
  · intro h
    obtain ⟨p, _, hp⟩ := Finset.mem_image.mp h
    have hn := congrArg Sigma.fst hp
    dsimp only at hn
    have hlt := p.1.isLt
    omega
  · intro h
    exact Finset.mem_image.mpr ⟨⟨⟨G.1, by omega⟩, G.2⟩, Finset.mem_univ _, rfl⟩

def forbiddenBasis {r : ℕ} (C : FiniteGraph r → Prop) [DecidablePred C]
    (B : ℕ) : Finset (FiniteGraph r) :=
  (bounded r B).filter fun G => ¬ C G

@[simp] theorem mem_forbiddenBasis {r : ℕ} (C : FiniteGraph r → Prop) [DecidablePred C]
    (B : ℕ) (G : FiniteGraph r) :
    G ∈ forbiddenBasis C B ↔ G.1 ≤ B ∧ ¬ C G := by
  simp [forbiddenBasis]

/-- A monotone class is exactly avoidance of its bounded, explicitly enumerated
obstructions once every failure has an ordinary embedded obstruction of that size. -/
theorem forbiddenBasis_spec {r : ℕ} (C : FiniteGraph r → Prop) [DecidablePred C]
    (B : ℕ) (hmono : ClassMonotone C)
    (hbounded : ∀ G, ¬ C G → ∃ A, A.1 ≤ B ∧ ¬ C A ∧ A.Contains G)
    (G : FiniteGraph r) :
    C G ↔ ∀ A ∈ forbiddenBasis C B, ¬ A.Contains G := by
  constructor
  · intro hG A hA hemb
    exact ((mem_forbiddenBasis C B A).mp hA).2 (hmono A G hemb hG)
  · intro hfree
    by_contra hG
    obtain ⟨A, hsize, hA, hemb⟩ := hbounded G hG
    exact hfree A ((mem_forbiddenBasis C B A).mpr ⟨hsize, hA⟩) hemb

theorem forbiddenBasis_has_edges {r : ℕ} (C : FiniteGraph r → Prop) [DecidablePred C]
    (B : ℕ) (hedgeless : ∀ G, G.2.edges = ∅ → C G)
    {A : FiniteGraph r} (hA : A ∈ forbiddenBasis C B) : A.2.edges.Nonempty := by
  by_contra h
  exact ((mem_forbiddenBasis C B A).mp hA).2
    (hedgeless A (Finset.not_nonempty_iff_eq_empty.mp h))

end FiniteGraph
end TuranUniversality
